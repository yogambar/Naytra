# ─── Naytra API – Environment Variables ────────────────────────────────────
# Copy this file to .env and adjust values for your environment.

# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://naytra:naytra_dev@localhost:5432/naytra

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Debug mode (true / false)
DEBUG=true

# Data mode: REPLAY | LIVE
DATA_MODE=REPLAY

# Signup bonus range (INR paise)
SIGNUP_BONUS_MIN_INR=1000
SIGNUP_BONUS_MAX_INR=10000

# Enable / disable signup bonus
SIGNUP_BONUS_ENABLED=true

# Application version (auto-set from pyproject.toml in CI)
APP_VERSION=0.1.0
