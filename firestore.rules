rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Default Deny Fallback
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // 1. User Profiles Collection: users/{userId}
    // ===============================================================
    match /users/{userId} {
      // Allows read and write (create, update, delete) for the authenticated document owner.
      // Supports getDoc, setDoc, updateDoc, and setDoc with merge: true seamlessly.
      allow read, write: if isOwner(userId);
    }

    // ===============================================================
    // 2. Virtual Wallets Collection: wallets/{userId}
    // ===============================================================
    match /wallets/{userId} {
      // Allows read and write (create, update, delete) for the authenticated document owner.
      allow read, write: if isOwner(userId);

      // =============================================================
      // 3. Double-Entry Ledger Subcollection: wallets/{userId}/ledger/{entryId}
      // =============================================================
      match /ledger/{entryId} {
        // Allows read and write for the authenticated document owner.
        allow read, write: if isOwner(userId);
      }
    }
  }
}
