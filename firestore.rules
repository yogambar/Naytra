rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the owner of the user-scoped document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // 1. User Profiles Collection: users/{userId}
    // ===============================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ===============================================================
    // 2. Virtual Wallets Collection: wallets/{userId}
    // ===============================================================
    match /wallets/{userId} {
      allow read, write: if isOwner(userId);

      // Double-Entry Ledger Subcollection
      match /ledger/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // 3. Portfolios Collection: portfolios/{userId}
    // ===============================================================
    match /portfolios/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ===============================================================
    // 4. Orders Collection: orders/{userId}
    // ===============================================================
    match /orders/{userId} {
      allow read, write: if isOwner(userId);

      match /user_orders/{orderId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // 5. Watchlists Collection: watchlists/{userId}
    // ===============================================================
    match /watchlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ===============================================================
    // Fallback Deny Rule
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
